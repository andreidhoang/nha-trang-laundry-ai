{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giatlasachcong.vn/contracts/trusted-release-signers-v1.schema.json",
  "title": "Out-of-band trusted release signer registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "signers"],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,120}$"
    },
    "signers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "function", "actor_id", "algorithm", "public_key_pem"],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{4,160}$"
          },
          "function": {
            "type": "string",
            "enum": ["OWNER", "SECURITY", "OPERATIONS"]
          },
          "actor_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{4,160}$"
          },
          "algorithm": {
            "type": "string",
            "enum": ["ED25519", "ECDSA_P256_SHA256"]
          },
          "public_key_pem": {
            "type": "string",
            "minLength": 80,
            "maxLength": 2048,
            "pattern": "^-----BEGIN PUBLIC KEY-----\\n"
          }
        }
      }
    }
  }
}
