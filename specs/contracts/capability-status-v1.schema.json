{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giatlasachcong.vn/contracts/capability-status-v1.schema.json",
  "title": "Fail-closed capability authorization status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "last_updated", "project_stage", "default_authorization", "capabilities"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "last_updated": { "type": "string", "format": "date" },
    "project_stage": { "type": "string", "minLength": 1 },
    "default_authorization": { "const": "NOT_AUTHORIZED" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/CapabilityStatus" }
    }
  },
  "$defs": {
    "CapabilityId": {
      "type": "string",
      "enum": [
        "INTERNAL_SHADOW", "PUBLIC_FAQ", "LIST_PRICE_INFO", "INTAKE_QUESTION",
        "INTAKE_FACT_CAPTURE", "INTAKE_RECEIPT", "INCIDENT_RECEIPT", "ORDER_STATUS",
        "SLA_GUIDANCE", "QUOTE_ESTIMATE", "BOOKING", "DELIVERY_ADVISORY",
        "MARKETING_FOLLOWUP"
      ]
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "required"],
      "properties": {
        "observed": { "type": "integer", "minimum": 0 },
        "required": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "EvidenceProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "required"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "required": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "CapabilityStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "stage", "code_status", "authorization", "required_gates", "evidence",
        "zero_tolerance_incidents", "eligible_real_cases", "clean_days", "kill_switch_drill",
        "release_manifest", "trusted_signers", "blockers"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/CapabilityId" },
        "stage": {
          "type": "string",
          "enum": ["MANUAL_TRUTH", "SHADOW", "ASSISTED", "BOUNDED"]
        },
        "code_status": {
          "type": "string",
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE", "BLOCKED"]
        },
        "authorization": {
          "type": "string",
          "enum": ["NOT_AUTHORIZED", "AUTHORIZED"]
        },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "G1_INTERNAL_SHADOW_READY", "G2_PUBLIC_ASSISTED_ENTRY",
              "G3_ASSISTED_EVIDENCE_COMPLETE", "G4_BOUNDED_CAPABILITY_ENTRY"
            ]
          }
        },
        "evidence": { "$ref": "#/$defs/EvidenceProgress" },
        "zero_tolerance_incidents": { "type": "integer", "minimum": 0 },
        "eligible_real_cases": { "$ref": "#/$defs/Progress" },
        "clean_days": { "$ref": "#/$defs/Progress" },
        "kill_switch_drill": {
          "type": "string",
          "enum": ["NOT_RUN", "PASSED", "FAILED"]
        },
        "release_manifest": { "type": ["string", "null"], "minLength": 1 },
        "trusted_signers": { "type": ["string", "null"], "minLength": 1 },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "authorization": { "const": "AUTHORIZED" } } },
          "then": {
            "properties": {
              "release_manifest": { "type": "string", "minLength": 1 },
              "trusted_signers": { "type": "string", "minLength": 1 }
            }
          },
          "else": {
            "properties": {
              "release_manifest": { "const": null },
              "trusted_signers": { "const": null }
            }
          }
        }
      ]
    }
  }
}
