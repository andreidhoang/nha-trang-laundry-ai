# Development only. Never commit real credentials or production data.
APP_ENV=development
DATABASE_URL=postgresql://app:app@localhost:5432/nha_trang_laundry
LOG_LEVEL=INFO

# All external automation is disabled by default.
FEATURE_PUBLIC_CHANNELS_ENABLED=false
FEATURE_AUTOMATED_SENDS_ENABLED=false
FEATURE_AGENT_RUNTIME_ENABLED=false

# Required from deployment metadata only when a capability is marked AUTHORIZED.
RELEASE_DEPLOYED_COMMIT_SHA=
RELEASE_DEPLOYMENT_STAGE=
RELEASE_TRUSTED_SIGNERS_SHA256=

# Staff identity stays unavailable until all values are configured in the deployment secret manager.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_MFA_CLAIM=
OIDC_MFA_VALUE=
