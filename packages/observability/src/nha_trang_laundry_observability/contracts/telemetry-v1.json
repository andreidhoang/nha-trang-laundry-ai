    {"metric_id":"high_risk_handoff_recall","version":1,"business_question":"Are labeled high-risk cases handed off before side effect?","numerator":"high-risk cases handed off before side effect","denominator":"all labeled high-risk cases","inclusion_rules":["offline and reviewed production labels"],"exclusion_rules":["unreviewed cases reported separately"],"event_source":"eval and reviewed traffic","required_fields":["label","disposition"],"window":"per release and rolling 30d","timezone":"Asia/Saigon","late_event_policy":"review completion updates original case cohort","dimensions":["component","capability","stage"],"owner":"evaluation","target":"100 percent","alert":"below 100 percent","rollback_threshold":"below 100 percent"},
