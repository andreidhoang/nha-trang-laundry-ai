{
  "schema_version": 1,
  "contract_version": "telemetry-v1",
  "metrics": [
    {"metric_id":"api_requests_total","version":1,"business_question":"Are internal API requests succeeding?","numerator":"count of requests by bounded outcome","denominator":"all internal API requests","inclusion_rules":["completed middleware requests"],"exclusion_rules":["health probes are separately dimensioned"],"event_source":"API server middleware","required_fields":["operation","outcome","status_class"],"window":"rolling 5m and 24h","timezone":"Asia/Saigon","late_event_policy":"ingest within 5m; later data repairs reports only","dimensions":["component","operation","outcome","status_class"],"owner":"platform","target":"99.5% successful during business hours","alert":"availability below target","rollback_threshold":"new release increases 5xx rate above 1%"},
    {"metric_id":"api_latency_ms","version":1,"business_question":"Is internal API latency bounded?","numerator":"request elapsed milliseconds","denominator":"all completed requests","inclusion_rules":["server processing time"],"exclusion_rules":["client rendering time"],"event_source":"API server middleware","required_fields":["operation","elapsed_ms"],"window":"p50/p95/p99 rolling 24h","timezone":"Asia/Saigon","late_event_policy":"ingest within 5m; later data repairs reports only","dimensions":["component","operation","outcome","status_class"],"owner":"platform","target":"quote p95 below 500ms","alert":"quote p95 at or above 500ms","rollback_threshold":"quote p95 at or above 750ms after release"},
    {"metric_id":"database_latency_ms","version":1,"business_question":"Is database work delaying the control plane?","numerator":"database operation elapsed milliseconds","denominator":"all instrumented database operations","inclusion_rules":["connection and query execution"],"exclusion_rules":["application compute"],"event_source":"database client spans","required_fields":["operation","elapsed_ms"],"window":"p50/p95/p99 rolling 24h","timezone":"Asia/Saigon","late_event_policy":"ingest within 5m; later data repairs reports only","dimensions":["component","operation","outcome"],"owner":"platform","target":"baseline before enforcement","alert":"p95 exceeds baselined threshold","rollback_threshold":"release doubles baseline p95"},
    {"metric_id":"queue_depth","version":1,"business_question":"How much durable work is ready?","numerator":"ready item count","denominator":"not applicable","inclusion_rules":["eligible PENDING records"],"exclusion_rules":["human wait and scheduled future work"],"event_source":"queue projection query","required_fields":["queue","depth"],"window":"sample every 60s","timezone":"Asia/Saigon","late_event_policy":"discard samples older than 5m","dimensions":["component","queue"],"owner":"operations","target":"baseline before enforcement","alert":"depth exceeds baselined threshold","rollback_threshold":"sustained growth after release"},
    {"metric_id":"queue_oldest_age_s","version":1,"business_question":"Is ready work waiting too long?","numerator":"seconds since oldest eligible item became ready","denominator":"not applicable","inclusion_rules":["eligible ready items"],"exclusion_rules":["retry backoff dependency outage and human approval"],"event_source":"queue projection query","required_fields":["queue","ready_at"],"window":"sample every 60s","timezone":"Asia/Saigon","late_event_policy":"discard samples older than 5m","dimensions":["component","queue"],"owner":"operations","target":"p95 below 15s","alert":"oldest age above 300s","rollback_threshold":"p95 at or above 30s after release"},
    {"metric_id":"queue_retries_total","version":1,"business_question":"Are durable handlers repeatedly failing?","numerator":"retry transitions","denominator":"claimed items","inclusion_rules":["durably scheduled retries"],"exclusion_rules":["initial attempts"],"event_source":"outbox and agent-run state transitions","required_fields":["queue","retryable"],"window":"rolling 5m and 24h","timezone":"Asia/Saigon","late_event_policy":"event time with 5m allowance","dimensions":["component","queue","outcome","retryable"],"owner":"operations","target":"baseline before enforcement","alert":"retry rate exceeds baseline","rollback_threshold":"new release doubles retry rate"},
    {"metric_id":"dlq_items_total","version":1,"business_question":"Has any work entered a dead letter state?","numerator":"new DLQ records","denominator":"all claimed durable items","inclusion_rules":["first transition to DEAD"],"exclusion_rules":["manual views and replay attempts"],"event_source":"dead_letter_events insert","required_fields":["queue","occurred_at"],"window":"rolling 5m and lifetime","timezone":"Asia/Saigon","late_event_policy":"event time; never discard","dimensions":["component","queue","outcome"],"owner":"operations","target":"zero","alert":"any item within 5m during business hours","rollback_threshold":"any release-correlated item"},
    {"metric_id":"agent_budget_exhausted_total","version":1,"business_question":"Are agent runs exhausting deterministic budgets?","numerator":"budget exhaustion decisions","denominator":"all attempted agent runs","inclusion_rules":["token call tool wall-clock and cost ceilings"],"exclusion_rules":["operator cancellation"],"event_source":"agent-run decision events","required_fields":["capability","stage","budget_kind"],"window":"rolling 24h","timezone":"Asia/Saigon","late_event_policy":"event time with 5m allowance","dimensions":["component","capability","stage","outcome"],"owner":"agent-platform","target":"baseline before enforcement","alert":"rate exceeds baselined threshold","rollback_threshold":"new model doubles exhaustion rate"},
    {"metric_id":"agent_processing_latency_ms","version":1,"business_question":"Are claimed agent runs persisted within objective?","numerator":"inbox claim to persisted draft or deterministic result milliseconds","denominator":"all completed agent runs","inclusion_rules":["authenticated AGENT_RUNNER runs"],"exclusion_rules":["queue-before-claim human wait and provider delivery"],"event_source":"agent trace events","required_fields":["claimed_at","result_persisted_at","stage"],"window":"p50/p95/p99 rolling 24h","timezone":"Asia/Saigon","late_event_policy":"event time with 5m allowance","dimensions":["component","capability","stage","outcome"],"owner":"agent-platform","target":"p95 below 15000ms and hard timeout 20000ms","alert":"p95 at or above 15000ms","rollback_threshold":"p95 at or above 20000ms"},
    {"metric_id":"agent_cost_usd","version":1,"business_question":"Is model spend within deterministic guardrails?","numerator":"settled provider cost in USD","denominator":"completed or abandoned charged runs","inclusion_rules":["all model calls including repair and fallback"],"exclusion_rules":["unsettled reservations shown separately"],"event_source":"cost reservation settlement","required_fields":["capability","stage","cost_usd"],"window":"per turn daily and monthly","timezone":"Asia/Saigon","late_event_policy":"settlements repair original event date","dimensions":["component","capability","stage","outcome"],"owner":"agent-platform","target":"routine turn at or below USD 0.03 and hard cap USD 0.10","alert":"50 80 and 100 percent of configured caps","rollback_threshold":"any hard-cap violation"},
    {"metric_id":"approval_backlog","version":1,"business_question":"How many approval requests require human action?","numerator":"pending non-expired approvals","denominator":"not applicable","inclusion_rules":["current PENDING approvals"],"exclusion_rules":["decided expired and stale approvals"],"event_source":"approval projection query","required_fields":["status","expires_at"],"window":"sample every 60s","timezone":"Asia/Saigon","late_event_policy":"discard samples older than 5m","dimensions":["component","outcome"],"owner":"operations","target":"baseline before enforcement","alert":"backlog or age exceeds baseline","rollback_threshold":"new release causes sustained growth"},
    {"metric_id":"suppression_miss_count","version":1,"business_question":"Did marketing execute after effective suppression?","numerator":"marketing executions after effective suppression","denominator":"all marketing executions","inclusion_rules":["all channels and execution paths"],"exclusion_rules":["no exclusions"],"event_source":"consent ingress and egress audit join","required_fields":["suppression_effective_at","executed_at"],"window":"lifetime and rolling 30d","timezone":"Asia/Saigon","late_event_policy":"event time; never discard","dimensions":["component","outcome"],"owner":"privacy","target":"zero","alert":"any occurrence","rollback_threshold":"any occurrence"},
    {"metric_id":"kill_switch_age_s","version":1,"business_question":"Is execution using fresh kill-switch state?","numerator":"seconds since last authoritative switch refresh","denominator":"not applicable","inclusion_rules":["each worker and agent poll"],"exclusion_rules":["disabled process without execution authority"],"event_source":"configuration authority check","required_fields":["refreshed_at","stage"],"window":"sample every poll","timezone":"Asia/Saigon","late_event_policy":"discard superseded samples","dimensions":["component","stage"],"owner":"platform","target":"fresh within 60s","alert":"age above 60s","rollback_threshold":"any execution with stale state"},
    {"metric_id":"denied_capability_total","version":1,"business_question":"Which bounded capabilities are denied by policy?","numerator":"fail-closed capability denials","denominator":"all capability decisions","inclusion_rules":["PDP and release-gate denials"],"exclusion_rules":["input validation failures"],"event_source":"policy decision events","required_fields":["capability","stage","outcome"],"window":"rolling 5m and 24h","timezone":"Asia/Saigon","late_event_policy":"event time with 5m allowance","dimensions":["component","capability","stage","outcome"],"owner":"security","target":"expected denials baselined by stage","alert":"unexpected spike","rollback_threshold":"new release increases unexpected denials"},
    {"metric_id":"backup_age_s","version":1,"business_question":"Is the latest recoverable database backup fresh?","numerator":"seconds since last verified backup","denominator":"not applicable","inclusion_rules":["integrity-verified backups"],"exclusion_rules":["failed or incomplete backups"],"event_source":"backup verifier","required_fields":["verified_at"],"window":"sample hourly","timezone":"Asia/Saigon","late_event_policy":"latest verified sample wins","dimensions":["component","operation","outcome"],"owner":"platform","target":"fresh within 24h","alert":"age above 24h or backup failure","rollback_threshold":"backup verification failure"},
    {"metric_id":"restore_test_age_s","version":1,"business_question":"Has restore capability been demonstrated recently?","numerator":"seconds since last successful restore test","denominator":"not applicable","inclusion_rules":["completed integrity-checked restore drills"],"exclusion_rules":["unverified startup tests"],"event_source":"restore drill evidence","required_fields":["verified_at"],"window":"sample daily","timezone":"Asia/Saigon","late_event_policy":"latest verified sample wins","dimensions":["component","operation","outcome"],"owner":"platform","target":"fresh within 90d","alert":"age above 90d or restore failure","rollback_threshold":"restore verification failure"},
    {"metric_id":"confirmed_money_exact_rate","version":1,"business_question":"Do confirmed monetary values equal approved structured facts?","numerator":"confirmed messages and orders with exact current values","denominator":"all confirmed or sent messages containing money","inclusion_rules":["manual fallback deterministic and future authorized sends"],"exclusion_rules":["drafts never confirmed or sent"],"event_source":"message and quote audit join","required_fields":["rendered_hash","quote_snapshot_hash"],"window":"rolling 30d","timezone":"Asia/Saigon","late_event_policy":"corrections restate original event date","dimensions":["component","stage"],"owner":"commercial-controls","target":"100 percent","alert":"below 100 percent","rollback_threshold":"any wrong confirmed value"},
