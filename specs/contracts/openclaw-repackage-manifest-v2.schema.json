{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giatlasachcong.vn/contracts/openclaw-repackage-manifest-v2.schema.json",
  "title": "Immutable derived EVAL_ONLY OpenClaw repackage manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_origin",
    "artifact_status",
    "upstream",
    "base",
    "allowed_file_mutations",
    "replacements",
    "output",
    "image",
    "activation"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "artifact_origin": { "const": "DERIVED" },
    "artifact_status": { "const": "EVAL_ONLY" },
    "upstream": { "$ref": "#/$defs/Material" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "integrity", "size", "manifest_path", "manifest_sha256"],
      "properties": {
        "filename": { "const": "openclaw-2026.7.1-2-nha-trang-r1.tgz" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "integrity": { "$ref": "#/$defs/Integrity" },
        "size": { "type": "integer", "minimum": 1 },
        "manifest_path": { "const": "runtime/openclaw/repack/manifest-v1.json" },
        "manifest_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "allowed_file_mutations": {
      "const": ["package/package.json", "package/npm-shrinkwrap.json"]
    },
    "replacements": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "plugin_lock_path",
          "required_by_path",
          "required_range",
          "range_policy",
          "source",
          "replacement"
        ],
        "properties": {
          "path": { "type": "string", "pattern": "^node_modules/[a-z0-9._-]+$" },
          "plugin_lock_path": {
            "type": "string",
            "pattern": "^node_modules/(?:openclaw/node_modules/)?[a-z0-9._-]+$"
          },
          "required_by_path": {
            "type": "string",
            "pattern": "^(?:|node_modules/[a-z0-9._/-]+)$"
          },
          "required_range": {
            "type": "string",
            "pattern": "^(?:\\^)?[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "range_policy": {
            "enum": ["SATISFIES_DECLARED_RANGE", "REVIEWED_EXACT_METADATA_CHANGE"]
          },
          "source": { "$ref": "#/$defs/Material" },
          "replacement": { "$ref": "#/$defs/Material" },
          "package_dependency_mutation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "json_pointer", "source_value", "replacement_value"],
            "properties": {
              "file": { "const": "package/package.json" },
              "json_pointer": { "const": "/dependencies/undici" },
              "source_value": { "const": "8.5.0" },
              "replacement_value": { "const": "8.9.0" }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "integrity", "size"],
      "properties": {
        "filename": { "const": "openclaw-2026.7.1-2-nha-trang-r2.tgz" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "integrity": { "$ref": "#/$defs/Integrity" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "dockerfile",
        "base_image",
        "target_platform",
        "provenance_predicate_type",
        "hosted_evidence_required"
      ],
      "properties": {
        "repository": { "const": "nha-trang-laundry-openclaw" },
        "dockerfile": { "const": "runtime/openclaw/repack/Dockerfile" },
        "base_image": {
          "type": "string",
          "pattern": "^node:24\\.15\\.0-alpine3\\.23@sha256:[0-9a-f]{64}$"
        },
        "target_platform": { "const": "linux/amd64" },
        "provenance_predicate_type": { "const": "https://slsa.dev/provenance/v1" },
        "hosted_evidence_required": { "const": true }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_customer_data_allowed",
        "public_ingress_enabled",
        "provider_calls_enabled",
        "automatic_send_enabled",
        "direct_send_enabled"
      ],
      "properties": {
        "real_customer_data_allowed": { "const": false },
        "public_ingress_enabled": { "const": false },
        "provider_calls_enabled": { "const": false },
        "automatic_send_enabled": { "const": false },
        "direct_send_enabled": { "const": false }
      }
    }
  },
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "Integrity": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
    },
    "Material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "url",
        "integrity",
        "sha256",
        "size",
        "package_json_sha256"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9@._/-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9]+)?$" },
        "url": {
          "type": "string",
          "pattern": "^https://registry\\.npmjs\\.org/[a-z0-9@._/-]+\\.tgz$"
        },
        "integrity": { "$ref": "#/$defs/Integrity" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "package_json_sha256": { "$ref": "#/$defs/Sha256" },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
