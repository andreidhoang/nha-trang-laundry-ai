# Local demo only. This file adds one route the production Caddyfile does not have:
# /demo-idp/* reaches the development identity provider, so a human can obtain a session in a
# browser. The service behind it exists only in compose.demo.yaml.
#
# Everything else is deployed/staging/Caddyfile unchanged, including the host check: a request
# that does not name staging.internal is still refused with 421.
{
	admin off
	auto_https off
}

:8443 {
	tls /run/secrets/tls_certificate /run/secrets/tls_private_key
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# `localhost` and `127.0.0.1` alongside the demo name, so the console opens on a machine
	# with no DNS entry for it. Not a loosening: the port is published on 127.0.0.1 only, so all
	# three names reach the same loopback listener and nothing off this machine reaches it at
	# all. The demo certificate already carries both as subject alternative names, so the
	# browser's only complaint is the private CA, which it would make anyway.
	#
	# This is the demo file. `deploy/staging/Caddyfile` and the R1 topology are unchanged: there
	# one name is the whole point, and anything else still gets 421.
	@private_operator host staging.internal localhost 127.0.0.1
	handle @private_operator {
		handle_path /demo-idp/* {
			reverse_proxy demo-idp:9000
		}
		redir /demo-idp /demo-idp/ 308
		reverse_proxy api:8000
	}

	handle {
		respond "unrecognized private host" 421
	}
}
