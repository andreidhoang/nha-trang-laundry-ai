{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giatlasachcong.vn/evals/eval-case-v1.schema.json",
  "title": "Laundry agent evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "severity",
    "capability",
    "stage",
    "dataset_layer",
    "runtime_path",
    "eligibility_label",
    "fixture_refs",
    "input",
    "expected",
    "graders"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(P0|P1|P2)-[A-Z0-9_-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "capability": {
      "type": "string",
      "enum": [
        "CATALOG_READ",
        "INTAKE_DRAFT",
        "INTAKE_FACT_WRITE",
        "QUOTE_ESTIMATE",
        "FINAL_QUOTE",
        "DELIVERY_ADVISORY",
        "CAPACITY_ADVISORY",
        "MESSAGE_DRAFT",
        "MESSAGE_SEND",
        "MARKETING_SEND",
        "LIST_PRICE_INFO",
        "ORDER_STATUS_READ",
        "INCIDENT_INTAKE",
        "APPROVAL_REQUEST",
        "CONSENT",
        "CUSTOMER_CORRECTION"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "MANUAL_TRUTH",
        "SHADOW",
        "ASSISTED",
        "BOUNDED"
      ]
    },
    "dataset_layer": {
      "type": "string",
      "enum": [
        "SEED",
        "FROZEN_REGRESSION",
        "NORMAL_LANGUAGE",
        "ADVERSARIAL",
        "SYNTHETIC_COMBINATORIAL",
        "PUBLIC_CORPUS",
        "PRODUCTION_REPLAY"
      ]
    },
    "runtime_path": {
      "type": "string",
      "enum": [
        "PRIMARY",
        "FALLBACK",
        "DETERMINISTIC_DEGRADED"
      ]
    },
    "eligibility_label": {
      "type": "string",
      "enum": [
        "ELIGIBLE",
        "INELIGIBLE",
        "AMBIGUOUS_ABSTAIN"
      ]
    },
    "fixture_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^fixture:[a-z0-9_-]+:v[1-9][0-9]*$"
      }
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_call_order",
        "tool_calls",
        "policy_outcome",
        "message_kind",
        "send_eligible",
        "side_effects",
        "assertion_ids"
      ],
      "properties": {
        "tool_call_order": {
          "type": "string",
          "enum": [
            "SEQUENTIAL",
            "ORDER_INSENSITIVE",
            "NONE"
          ]
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id"
            ],
            "properties": {
              "operation_id": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]+$"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "maximum_count": {
                "type": "integer",
                "minimum": 0
              },
              "request_subset": {
                "type": "object"
              },
              "forbidden_request_fields": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            },
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "count"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "maximum_count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "maximum_count"
                ]
              }
            ]
          }
        },
        "policy_outcome": {
          "type": "string",
          "enum": [
            "ALLOW",
            "REQUIRE_HUMAN",
            "DENY"
          ]
        },
        "message_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "LIST_PRICE_INFO",
            "INTAKE_FACT_REQUEST",
            "INTAKE_RECEIPT",
            "INCIDENT_RECEIPT",
            "ORDER_STATUS",
            "APPROVED_QUOTE_PRESENTATION",
            "APPROVED_SLOT_PRESENTATION",
            "FREE_FORM_TRANSACTIONAL",
            "MARKETING",
            null
          ]
        },
        "send_eligible": {
          "type": "boolean"
        },
        "side_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "assertion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ASSERT_[A-F0-9]{16}$"
          }
        }
      }
    },
    "graders": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "exact",
          "trace",
          "schema",
          "safety",
          "semantic_vi"
        ]
      }
    }
  }
}
