    {"metric_id":"eligible_abstention_rate","version":1,"business_question":"How often do eligible cases abstain or hand off?","numerator":"reviewed eligible cases abstained or handed off","denominator":"all reviewed eligible cases","inclusion_rules":["all bounded capabilities"],"exclusion_rules":["ineligible cases"],"event_source":"decision and review audit","required_fields":["eligibility_label","disposition"],"window":"per capability rolling 30d","timezone":"Asia/Saigon","late_event_policy":"review completion updates original case cohort","dimensions":["component","capability","stage"],"owner":"evaluation","target":"report without relabeling","alert":"baseline before enforcement","rollback_threshold":"regression beyond approved release bound"},
    {"metric_id":"required_abstention_rate","version":1,"business_question":"Do ambiguous or out-of-scope cases abstain?","numerator":"reviewed ambiguous or out-of-scope cases abstained or handed off","denominator":"all reviewed ambiguous or out-of-scope cases","inclusion_rules":["all bounded capabilities"],"exclusion_rules":["clearly eligible cases"],"event_source":"decision and review audit","required_fields":["scope_label","disposition"],"window":"per capability rolling 30d","timezone":"Asia/Saigon","late_event_policy":"review completion updates original case cohort","dimensions":["component","capability","stage"],"owner":"evaluation","target":"100 percent","alert":"below 100 percent","rollback_threshold":"below 100 percent"},
    {"metric_id":"duplicate_send_count","version":1,"business_question":"Was a logical send executed more than once?","numerator":"logical send keys with more than one provider execution","denominator":"all executed logical send keys","inclusion_rules":["all channels and retry paths"],"exclusion_rules":["provider receipts for the same execution"],"event_source":"outbox and provider receipt join","required_fields":["logical_idempotency_key","provider_execution_id"],"window":"rolling 30d","timezone":"Asia/Saigon","late_event_policy":"event time; never discard","dimensions":["component","stage"],"owner":"operations","target":"zero","alert":"any occurrence","rollback_threshold":"any occurrence"},
