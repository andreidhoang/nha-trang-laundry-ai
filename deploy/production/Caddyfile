# The shop's console, on the shop's own network.
#
# ADR-0007 §1: the staff console is never reachable from the internet. Staff reach it over the
# shop LAN or a VPN address, and this proxy is the only listener the host publishes. There is no
# public path here because R1 has no public ingress: the webhook path Zone P exists for belongs to
# a channel nobody has connected.
#
# `auto_https off` because the console hostname is internal, so no public CA can issue for it and
# there is no ACME challenge that could ever succeed. The certificate is the owner's, from a private
# CA that has to be installed *and explicitly trusted* on every tablet -- on iOS that is a second
# step, and its failure mode is a console that will not load with no useful error.

{
	admin off
	auto_https off
}

:8443 {
	tls /run/secrets/tls_certificate /run/secrets/tls_private_key
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# One name, matched exactly. Anything else is told nothing about what runs here.
	@console host {$R1_CONSOLE_HOST:console.giatlasachcong.lan}
	handle @console {
		# The identity provider, same origin as the console. That is a necessity rather than a
		# preference: the API sets `connect-src 'self'` and `form-action 'self'` on everything it
		# serves, so the browser cannot reach an issuer on another origin. Only the realm's own
		# browser endpoints are exposed -- the admin console, the master realm and the management
		# port are not reachable from the shop network at all.
		handle /idp/realms/nhatrang/* {
			reverse_proxy keycloak:8080
		}
		handle /idp/resources/* {
			reverse_proxy keycloak:8080
		}
		handle /idp* {
			respond 404
		}

		# The sign-in pages are served here rather than from `apps/web`, so they stay out of the
		# console's service-worker manifest and out of its disclosure registry -- both of which are
		# content-hashed over authored console source and would treat these as console screens.
		# They are outside `BrowserSecurityMiddleware`, so the policy they would have inherited is
		# stated explicitly and is at least as strict.
		handle /signin/* {
			root * /srv/signin
			header {
				Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:"
				X-Content-Type-Options nosniff
				X-Frame-Options DENY
				Referrer-Policy no-referrer
				Cache-Control "no-store"
			}
			file_server
		}

		reverse_proxy api:8000
	}

	handle {
		respond "unrecognized private host" 421
	}
}
